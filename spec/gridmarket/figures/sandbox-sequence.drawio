<mxfile host="azdiagram">
  <diagram id="sandbox-sequence" name="Judge sandbox onboarding sequence">
    <mxGraphModel pageWidth="960" pageHeight="530">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="judge" value="Judge" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;">
          <mxGeometry x="20" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="page" value="Sandbox page" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;">
          <mxGeometry x="220" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="api" value="api.py" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;">
          <mxGeometry x="420" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="market" value="market.py" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;">
          <mxGeometry x="620" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="feed" value="Activity feed" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;">
          <mxGeometry x="820" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="life-judge" value="" edge="1" parent="1" style="html=1;endArrow=none;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="60" as="sourcePoint" />
            <mxPoint x="80" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="life-page" value="" edge="1" parent="1" style="html=1;endArrow=none;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="60" as="sourcePoint" />
            <mxPoint x="280" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="life-api" value="" edge="1" parent="1" style="html=1;endArrow=none;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="60" as="sourcePoint" />
            <mxPoint x="480" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="life-market" value="" edge="1" parent="1" style="html=1;endArrow=none;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="60" as="sourcePoint" />
            <mxPoint x="680" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="life-feed" value="" edge="1" parent="1" style="html=1;endArrow=none;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="60" as="sourcePoint" />
            <mxPoint x="880" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-1" value="Get a sandbox key" edge="1" parent="1" style="html=1;" source="judge" target="page">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="110" as="sourcePoint" />
            <mxPoint x="280" y="110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-2" value="POST /v1/sandbox/keys" edge="1" parent="1" style="html=1;" source="page" target="api">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="160" as="sourcePoint" />
            <mxPoint x="480" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-3" value="key shown once" edge="1" parent="1" style="html=1;" source="api" target="page">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="210" as="sourcePoint" />
            <mxPoint x="280" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-4" value="Place a first order" edge="1" parent="1" style="html=1;" source="judge" target="page">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="260" as="sourcePoint" />
            <mxPoint x="280" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-5" value="POST /v1/orders" edge="1" parent="1" style="html=1;" source="page" target="api">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="310" as="sourcePoint" />
            <mxPoint x="480" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-6" value="risk, match, ledger" edge="1" parent="1" style="html=1;" source="api" target="market">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="360" as="sourcePoint" />
            <mxPoint x="680" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-7" value="event appended" edge="1" parent="1" style="html=1;" source="market" target="feed">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="410" as="sourcePoint" />
            <mxPoint x="880" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-8" value="GET /v1/orders every 2 s" edge="1" parent="1" style="html=1;" source="page" target="api">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="460" as="sourcePoint" />
            <mxPoint x="480" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
