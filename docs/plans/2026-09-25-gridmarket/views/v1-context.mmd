flowchart LR
    subgraph EXT["External actors (untrusted)"]
        ERCOT["ERCOT Public API (Worker only)"]
        NWS["NWS api.weather.gov (keyless)"]
        JEV["Hosted Jev API (flag-gated, off by default)"]
        OWNER["Owner / operator (holds keys, deploys Worker)"]
        JUDGE["Judge / developer (self-serve sandbox key)"]
        HUMAN["Human trader (dashboard, no login)"]
        AGENTS["User LLM agents + local gridmarket-mcp (stdio)"]
        VIEWER["3D viewer (owner views)"]
        BOTS["Bots: seeded 60 + owner cohorts (public API)"]
        FLEETS["Provider fleets (base-sim, LoneStar)"]
        OFFLINE["Offline ML sources (never live)"]
    end

    subgraph WORKER["Owner ERCOT Worker (external system, owner account): holds owner ERCOT credentials (TB-3)"]
        WSNAP["GET /api/snapshot (5-min cache)"]
        WREP["GET /api/report/* (allowlist + market client key)"]
        W3D["3D views (/, /godseye/): read /v1/market/activity + /v1/router via CORS; link to dashboard"]
        WLIM["Guards: per-client 30/60 s, ERCOT upstream 25/60 s, 429 backoff"]
    end

    subgraph TB1["TB-1: outbound Cloudflare named tunnel (only public path; admin never passes it)"]
        TUN["cloudflared"]
    end

    subgraph SYS["GridMarket boundary: Compose, non-root, host port 127.0.0.1 only"]
        API["FastAPI app + REST API (TB-2: API-key auth; admin loopback-only; CORS: Worker origin on public reads)"]
        ROUTER["Decision router: market + health checks, bands, heartbeat rule (Jev column only when flag on)"]
        WPOLL["Worker client poller (in-process): <= 12 req/60 s, x-gridmarket-key, never fresh; holds NO ERCOT credentials"]
        NPOLL["NWS poller (in-process): keyless + User-Agent, <= 6 req/60 s"]
        CORE["Policy/risk + MatchingEngine + SQLite WAL ledger (deposits excluded from P&L)"]
        ADAPT["Provider adapters: base-sim (phase 1), LoneStar (phase 2); 10 s heartbeats"]
        DASH["Dashboard static (7 pages, polls REST 2 s; links to 3D views)"]
    end

    JUDGE -->|HTTPS + sandbox key| TUN
    HUMAN -->|HTTPS, no login| TUN
    BOTS -->|HTTPS + account keys| TUN
    AGENTS -->|HTTPS + own sandbox key| TUN
    OWNER -->|operates keys, tunnel, ledger| TUN
    OWNER -.->|admin requests: loopback only| API
    TUN --> API
    API --> ROUTER
    API --> CORE
    API --> DASH
    CORE --> ADAPT
    FLEETS -.->|simulated assets via adapter interface| ADAPT
    WPOLL -->|snapshot + reports| WSNAP
    WPOLL -->|allowlisted reports + key| WREP
    WSNAP -->|ERCOT calls within 25/60 s budget| ERCOT
    WREP -->|ERCOT calls within 25/60 s budget| ERCOT
    WPOLL -->|stored ERCOT signals| CORE
    NPOLL -->|hourly temp + active alerts| NWS
    NPOLL -->|stored weather signals| CORE
    ROUTER -.->|flag on only: owner key, no state change| JEV
    W3D -.->|CORS GET public reads| API
    DASH <-.->|linked surfaces| W3D
    OFFLINE -.->|offline ML lane only, never live| CORE
