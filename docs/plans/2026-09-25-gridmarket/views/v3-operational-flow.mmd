flowchart TD
    subgraph ORD["Order path: one BEGIN IMMEDIATE transaction"]
        O1["POST /v1/orders + API key + Idempotency-Key"]
        O2["Auth (401) -> rate limit (429)"]
        O3["Idempotency: replay original / 409 on mismatch"]
        O4["Halt check (423) + provider check (PROVIDER_OFFLINE)"]
        O5["Risk: size <= 50, position <= 200, cash holds, capacity reserve"]
        O6["MatchingEngine: price-time fills at resting price"]
        O7["Append-only ledger / events + P&L"]
        O8["Response + dashboard activity feed <= 5 s"]
        O1 --> O2 --> O3 --> O4 --> O5 --> O6 --> O7 --> O8
    end

    subgraph SIG["Signal path: Worker + NWS polls to predictions"]
        E1["Poll Worker /api/snapshot every 5 min (market budget <= 12 req/60 s, never fresh)"]
        E2["Poll allowlisted Worker reports (5/60 min) + NWS temp/alerts (keyless, <= 6/60 s)"]
        E3["Store signals + publish/fetch time; stale + age on fault"]
        E4["Score per zone-hour 0-100: 7 factors (spread, load, outage, congestion, heat, peak, alerts)"]
        E5["Factor contributions: signed points + one-line explanation each"]
        E6["GET /v1/predictions + dashboard poll 2 s (always: estimate, not guaranteed profit)"]
        E7["FLEX cash-settle vs RT avg / 1000 (no clamp)"]
        E1 --> E2 --> E3 --> E4 --> E5 --> E6
        E3 --> E7
    end

    subgraph RBE["Router tick + bot loop + payroll tick"]
        R1["Router tick 60 s: market checks from signals + score (DART spread, fixed horizon, outcome recorded)"]
        R2["Health checks from WorkerStats + heartbeats (p offline within 15 min)"]
        R3["Bands: below 0.50 log, 0.50-0.80 review, 0.80+ alert; Brier score per check"]
        R4["Only the heartbeat rule acts: no heartbeat 30 s -> provider offline -> sells rejected PROVIDER_OFFLINE"]
        B1["Population sampler from master seed: 60 bots, 7 types, diversity layers"]
        B2["Bot loop: bots container -> SDK -> public API -> risk -> matching (<= 6 orders/min)"]
        P1["Payroll tick 60 s: pay to deposit ledger entries (not trades, excluded from P&L)"]
        P2["Settled positions feed loss statistics, net worth, dormant rate"]
        R1 --> R2 --> R3 --> R4
        B1 --> B2 --> O1
        R3 --> B2
        P1 --> P2
        O7 --> P2
    end

    E6 -.->|traders react to predictions| O1
    E3 -.->|signals feed market checks| R1
    R4 -.->|offline-provider sells rejected| O4
