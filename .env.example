GRIDMARKET_ADMIN_KEY=
# GRIDMARKET_ADMIN_NETS: comma-separated CIDRs of trusted local admin networks (defaults to loopback only).
GRIDMARKET_ADMIN_NETS=
GRIDMARKET_PORT=
# GRIDMARKET_DB: leave commented for the image default (/data/gridmarket.db).
GRIDMARKET_WORKER_URL=
GRIDMARKET_WORKER_KEY=
GRIDMARKET_CORS_ORIGIN=
GRIDMARKET_NWS=
GRIDMARKET_BOT_SECRET=
# GRIDMARKET_BOT_MASTER_SEED: leave commented for the default (20260926).
GRIDMARKET_JEV=
GRIDMARKET_JEV_URL=
GRIDMARKET_JEV_KEY=
# VITE_GODSEYE_URL: build-time God's Eye URL (<worker origin>/godseye/); empty hides it.
VITE_GODSEYE_URL=
